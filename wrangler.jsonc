{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ts-cf-dns-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "vars": {
    // 记录名格式：{PREFIX}{hostname}{POSTFIX}.{DOMAIN}
    "DOMAIN": "example.com",
    "PREFIX": "ts-",
    "POSTFIX": "",
    "VERIFY_SIGNATURE": "true"
  },
  "secrets": {
    "required": [
      "TAILNET",
      "TAILSCALE_API_KEY",
      "CF_API_TOKEN",
      "CF_ZONE_ID",
      "TS_WEBHOOK_SECRET"
    ]
    // TG_BOT_TOKEN / TG_CHAT_ID 可选（未设置则不发 Telegram 推送）
  }
}
